# Convex deployment URL
# Get this from your Convex dashboard after running `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# DEV ONLY: enables the UI-only "Dev: View as" impersonation control.
# Must NOT be set in production deployments.
NEXT_PUBLIC_ENABLE_DEV_IMPERSONATION=true
